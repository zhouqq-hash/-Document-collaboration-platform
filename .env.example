APP_DOMAIN=docs.example.com
ACME_EMAIL=admin@example.com
SECRET_KEY=replace-with-at-least-32-random-characters

# Tencent Cloud COS (private bucket)
STORAGE_BACKEND=cos
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-hongkong
COS_BUCKET=

# Optional: leave empty to keep AI disabled and use manual fallback.
COSMOS_API_KEY=
COSMOS_API_BASE=https://api.siliconflow.cn/v1
COSMOS_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Optional: real WeChat login. Mock login is always disabled here.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
WECHAT_AUTHORIZE_MODE=open
